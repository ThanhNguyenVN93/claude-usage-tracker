<Window x:Class="ClaudeUsageTracker.Views.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Usage - Thống kê" SizeToContent="Height" Width="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" Opacity="0">

    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.2"/>
        </Storyboard>
        <Style x:Key="RangeButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
    </Window.Resources>

    <Border Background="#1E1E2E" CornerRadius="12" BorderBrush="#45475A" BorderThickness="1" Margin="6">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="5" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel>
            <!-- Title bar / Draggable -->
            <Border Background="#181825" CornerRadius="12,12,0,0" Height="34" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0">
                    <TextBlock Text="📈 THỐNG KÊ USAGE" FontSize="11" FontWeight="Bold" Foreground="#FAB387" VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Foreground="#A6ADC8"
                            FontSize="12" FontWeight="Bold" Width="24" Height="24" Cursor="Hand" Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <StackPanel Margin="14,10,14,12">
                <!-- Dự báo -->
                <TextBlock Text="DỰ BÁO" FontSize="10" FontWeight="Bold" Foreground="#6C7086"/>
                <TextBlock x:Name="TxtProjection" Text="" FontSize="12" Foreground="#CDD6F4" TextWrapping="Wrap" Margin="0,3,0,0"/>
                <TextBlock x:Name="TxtContext" Text="" FontSize="11" Foreground="#A6ADC8" TextWrapping="Wrap" Margin="0,3,0,0"/>

                <Rectangle Height="1" Fill="#313244" Margin="0,10"/>

                <!-- Model đốt quota -->
                <Grid>
                    <TextBlock Text="MODEL NÀO ĐỐT QUOTA 5H (ƯỚC LƯỢNG)" FontSize="10" FontWeight="Bold" Foreground="#6C7086" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnBurn24h" Content="24h" Style="{StaticResource RangeButton}" Click="BtnBurn24h_Click"/>
                        <Button x:Name="BtnBurn7d" Content="7 ngày" Style="{StaticResource RangeButton}" Click="BtnBurn7d_Click"/>
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="BurnPanel" Margin="0,6,0,0"/>

                <Rectangle Height="1" Fill="#313244" Margin="0,10"/>

                <!-- Biểu đồ lịch sử -->
                <Grid>
                    <TextBlock Text="LỊCH SỬ" FontSize="10" FontWeight="Bold" Foreground="#6C7086" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnChart24h" Content="24h" Style="{StaticResource RangeButton}" Click="BtnChart24h_Click"/>
                        <Button x:Name="BtnChart7d" Content="7 ngày" Style="{StaticResource RangeButton}" Click="BtnChart7d_Click"/>
                    </StackPanel>
                </Grid>
                <Border Background="#181825" CornerRadius="6" Margin="0,6,0,0" Height="84">
                    <Canvas x:Name="ChartCanvas" ClipToBounds="True" SizeChanged="ChartCanvas_SizeChanged"/>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Rectangle Width="10" Height="3" Fill="#89B4FA" VerticalAlignment="Center"/>
                    <TextBlock Text=" 5 giờ" FontSize="10" Foreground="#A6ADC8" Margin="0,0,12,0"/>
                    <Rectangle Width="10" Height="3" Fill="#F38BA8" VerticalAlignment="Center"/>
                    <TextBlock Text=" Tuần" FontSize="10" Foreground="#A6ADC8"/>
                    <TextBlock x:Name="TxtChartRange" Text="" FontSize="10" Foreground="#6C7086" HorizontalAlignment="Right" Margin="12,0,0,0"/>
                </StackPanel>

                <TextBlock x:Name="TxtFootnote" FontSize="9" FontStyle="Italic" Foreground="#6C7086" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="Biểu đồ lịch sử gộp cả Desktop (API sync) lẫn CLI. Phân tích theo model chỉ hoạt động khi có Claude Code CLI (statusline.js) vì API claude.ai không trả về dữ liệu per-model. Quota dùng chung nên có thể lệch."/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
