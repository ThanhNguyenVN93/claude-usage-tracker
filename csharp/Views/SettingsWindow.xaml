<Window x:Class="ClaudeUsageTracker.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt Claude Usage Tracker" Height="780" Width="480"
        WindowStartupLocation="CenterScreen" WindowStyle="ToolWindow" Background="#181825"
        Icon="pack://application:,,,/Resources/app.ico">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Cài đặt" FontSize="15" FontWeight="Bold" Foreground="#F5E0DC"/>
            <TextBlock x:Name="TxtVersion" Text="Nguồn dữ liệu usage và tuỳ chọn chạy nền" FontSize="11" Foreground="#A6ADC8" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <TextBlock Text="1. Đồng bộ API thời gian thực (claude.ai)" FontSize="11" FontWeight="Bold" Foreground="#CDD6F4" Margin="0,0,0,4"/>
            <TextBlock Text="Dán sessionKey (cookie claude.ai) để lấy % và giờ reset chính xác ngay cả khi Claude Desktop đóng."
                       FontSize="10" FontStyle="Italic" Foreground="#6C7086" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PwdSessionKey" Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A"
                         Padding="8,6" FontSize="10" Height="30"
                         ToolTip="Lấy từ: F12 → Application → Cookies → claude.ai → sessionKey"/>
            <TextBlock x:Name="TxtSessionKeyHint" Text="Chưa cấu hình — để trống nếu không dùng tính năng này"
                       FontSize="10" FontStyle="Italic" Foreground="#6C7086" Margin="0,3,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Chu kỳ sync API (giây):" Foreground="#CDD6F4" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtApiSyncInterval" Text="300" Width="60" Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="4" HorizontalContentAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="0 = chỉ sync một lần khi khởi động (không lặp)" FontSize="10" FontStyle="Italic" Foreground="#6C7086" Margin="0,0,0,14"/>

            <Rectangle Height="1" Fill="#313244" Margin="0,0,0,14"/>

            <TextBlock Text="2. Claude Desktop (plan-usage-history.json)" FontSize="11" FontWeight="Bold" Foreground="#CDD6F4" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtDesktopPath" IsReadOnly="True" Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A"
                     Padding="8,6" FontSize="10" Height="30" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtDesktopStatus" Text="" FontSize="10" FontStyle="Italic" Margin="0,3,0,10"/>

            <TextBlock Text="3. Claude Code CLI (statusline.js)" FontSize="11" FontWeight="Bold" Foreground="#CDD6F4" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtCliPath" IsReadOnly="True" Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A"
                     Padding="8,6" FontSize="10" Height="30" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtCliStatus" Text="" FontSize="10" FontStyle="Italic" Margin="0,3,0,14"/>

            <Rectangle Height="1" Fill="#313244" Margin="0,0,0,14"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Chu kỳ quét tiến trình Claude (giây):" Foreground="#CDD6F4" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtInterval" Text="2" Width="50" Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="4" HorizontalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="Cảnh báo dữ liệu cũ sau (phút):" Foreground="#CDD6F4" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtStaleMinutes" Text="15" Width="50" Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="4" HorizontalContentAlignment="Center"/>
            </StackPanel>

            <CheckBox x:Name="ChkAutoStart" Content="Khởi động cùng Windows" Foreground="#CDD6F4" FontSize="11" Margin="0,0,0,14"/>

            <!-- Hotkey -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Phím tắt toggle HUD:" Foreground="#CDD6F4" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Border BorderBrush="#45475A" BorderThickness="1" CornerRadius="4" Background="#1E1E2E"
                        VerticalAlignment="Center">
                    <TextBox x:Name="TxtHotkey" Width="140" Background="Transparent" Foreground="#A6E3A1"
                             BorderThickness="0" Padding="6,3" FontSize="11" IsReadOnly="True"
                             VerticalContentAlignment="Center" Cursor="Hand"
                             PreviewKeyDown="TxtHotkey_PreviewKeyDown"
                             GotFocus="TxtHotkey_GotFocus" LostFocus="TxtHotkey_LostFocus"
                             ToolTip="Click vào rồi bấm tổ hợp phím mới"/>
                </Border>
                <Button x:Name="BtnResetHotkey" Content="Mặc định" Margin="6,0,0,0"
                        Background="#313244" Foreground="#A6ADC8" BorderThickness="0"
                        Padding="6,3" FontSize="10" Cursor="Hand" Click="BtnResetHotkey_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
            <TextBlock x:Name="TxtHotkeyHint" Text="Click vào ô rồi bấm tổ hợp phím (cần ít nhất 1 modifier: Ctrl/Alt/Win)"
                       FontSize="10" FontStyle="Italic" Foreground="#6C7086" Margin="0,0,0,14" TextWrapping="Wrap"/>

            <!-- Stats hotkey -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Phím tắt mở Stats:" Foreground="#CDD6F4" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Border BorderBrush="#45475A" BorderThickness="1" CornerRadius="4" Background="#1E1E2E"
                        VerticalAlignment="Center">
                    <TextBox x:Name="TxtStatsHotkey" Width="140" Background="Transparent" Foreground="#A6E3A1"
                             BorderThickness="0" Padding="6,3" FontSize="11" IsReadOnly="True"
                             VerticalContentAlignment="Center" Cursor="Hand"
                             PreviewKeyDown="TxtStatsHotkey_PreviewKeyDown"
                             GotFocus="TxtStatsHotkey_GotFocus" LostFocus="TxtStatsHotkey_LostFocus"
                             ToolTip="Click vào rồi bấm tổ hợp phím mới (mặc định: Ctrl+Shift+S)"/>
                </Border>
                <Button x:Name="BtnResetStatsHotkey" Content="Mặc định" Margin="6,0,0,0"
                        Background="#313244" Foreground="#A6ADC8" BorderThickness="0"
                        Padding="6,3" FontSize="10" Cursor="Hand" Click="BtnResetStatsHotkey_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <!-- Webhook URL -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Webhook URL (Discord/Slack):" Foreground="#CDD6F4" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </StackPanel>
            <TextBox x:Name="TxtWebhookUrl" Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A"
                     Padding="8,6" FontSize="10" Height="30" TextWrapping="NoWrap"
                     ToolTip="Để trống nếu không dùng. Bắt buộc https://. Hỗ trợ Discord webhook và generic JSON."/>
            <TextBlock x:Name="TxtWebhookHint"
                       Text="Cảnh báo usage sẽ POST đến URL này ngoài toast notification. Bắt buộc https://."
                       FontSize="10" FontStyle="Italic" Foreground="#6C7086" Margin="0,3,0,14" TextWrapping="Wrap"/>

            <Rectangle Height="1" Fill="#313244" Margin="0,0,0,14"/>

            <CheckBox x:Name="ChkAlerts" Content="Bật cảnh báo usage (balloon + đổi màu icon)" Foreground="#CDD6F4" FontSize="11" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Ngưỡng cảnh báo % (cách nhau dấu phẩy):" Foreground="#CDD6F4" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtThresholds" Text="80,95" Width="80" Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="4" HorizontalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Cảnh báo khi ngữ cảnh phiên đạt (%):" Foreground="#CDD6F4" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtContextWarn" Text="70" Width="50" Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="4" HorizontalContentAlignment="Center"/>
            </StackPanel>

            <CheckBox x:Name="ChkResetReminder" Content="Nhắc khi hạn ngạch đã reset sau lúc chạm trần" Foreground="#CDD6F4" FontSize="11" Margin="0,12,0,0"/>

            <CheckBox x:Name="ChkSoundAlert" Content="Phát âm thanh cảnh báo khi chạm ngưỡng nguy hiểm / lặp vô tận" Foreground="#CDD6F4" FontSize="11" Margin="0,8,0,0"/>

            <CheckBox x:Name="ChkUpdateCheck" Content="Tự kiểm tra bản mới trên GitHub (chỉ thông báo, hỏi trước khi tải)" Foreground="#CDD6F4" FontSize="11" Margin="0,8,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Độ rõ cửa sổ HUD (%):" Foreground="#CDD6F4" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtHudOpacity" Text="100" Width="50" Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="4" HorizontalContentAlignment="Center"/>
            </StackPanel>

            <Rectangle Height="1" Fill="#313244" Margin="0,14"/>

            <TextBlock Text="Bù độ trễ dữ liệu" FontSize="11" FontWeight="Bold" Foreground="#CDD6F4" Margin="0,0,0,8"/>
            <CheckBox x:Name="ChkEstimate" Content="Hiện số ước tính hiện tại (cộng theo nhịp tiêu gần đây)" Foreground="#CDD6F4" FontSize="11" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Cảnh báo khi Desktop và CLI lệch nhau từ (điểm %):" Foreground="#CDD6F4" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtDivergence" Text="4" Width="50" Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="4" HorizontalContentAlignment="Center"/>
            </StackPanel>

            <Rectangle Height="1" Fill="#313244" Margin="0,14"/>

            <TextBlock Text="Tự đổi model mặc định (Chỉ áp dụng cho Claude Code CLI)" FontSize="11" FontWeight="Bold" Foreground="#CDD6F4" Margin="0,0,0,4"/>
            <TextBlock Text="Ghi khoá model trong ~/.claude/settings.json khi quota cao, khôi phục khi quota hạ. Chỉ áp dụng cho phiên MỚI của Claude Code CLI (phiên đang chạy gõ /model haiku/sonnet). Với Claude Desktop/Web hãy chọn model trực tiếp trong app."
                       FontSize="10" FontStyle="Italic" Foreground="#89B4FA" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <CheckBox x:Name="ChkAutoModel" Content="Bật (mặc định tắt vì sửa cấu hình của Claude Code)" Foreground="#CDD6F4" FontSize="11" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Chuyển sang Sonnet khi quota ≥ (%):" Foreground="#CDD6F4" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtSonnetAt" Text="85" Width="50" Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="4" HorizontalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Chuyển sang Haiku khi quota ≥ (%):" Foreground="#CDD6F4" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtHaikuAt" Text="95" Width="50" Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="4" HorizontalContentAlignment="Center"/>
            </StackPanel>
            <Button Content="↩ Khôi phục ~/.claude/settings.json gốc (.bak)" Click="BtnRestoreBackup_Click" HorizontalAlignment="Left"
                    Background="#313244" Foreground="#A6ADC8" BorderThickness="0" Padding="8,4" FontSize="10" Cursor="Hand"/>
        </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Button Content="🧹 Dọn Cache &amp; Log cũ" Click="BtnCleanCache_Click" HorizontalAlignment="Left" Height="28" Padding="10,0"
                    Background="#313244" Foreground="#A6ADC8" BorderThickness="0" FontSize="11" Cursor="Hand"
                    ToolTip="Xoá log cũ, file tạm và dọn cache thừa trong thư mục dữ liệu của tool"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Click="BtnCancel_Click" Width="80" Height="28" Background="#313244" Foreground="#CDD6F4" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="Lưu cài đặt" Click="BtnSave_Click" Width="90" Height="28" Background="#F59E0B" Foreground="#11111B" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
