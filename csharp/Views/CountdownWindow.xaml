<Window x:Class="ClaudeUsageTracker.Views.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="180" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" Opacity="0">

    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
        </Storyboard>
    </Window.Resources>

    <Border Background="#181825" CornerRadius="10" BorderBrush="#45475A" BorderThickness="1" Margin="4">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="4" Opacity="0.4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar / draggable -->
            <Border Grid.Row="0" Background="#1E1E2E" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_Drag">
                <Grid Margin="10,0">
                    <TextBlock Text="⏰ ĐẾM NGƯỢC" FontSize="9" FontWeight="Bold"
                               Foreground="#6C7086" VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Foreground="#6C7086"
                            FontSize="10" Width="18" Height="18" Cursor="Hand" Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="12,8,12,12" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtTime" Text="--:--:--" FontSize="26" FontWeight="Bold"
                           Foreground="#A6E3A1" HorizontalAlignment="Center" FontFamily="Consolas"/>
                <TextBlock x:Name="TxtLabel" Text="đến khi reset" FontSize="10"
                           Foreground="#A6ADC8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                <TextBlock x:Name="TxtResetAt" Text="" FontSize="9"
                           Foreground="#6C7086" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                <TextBlock x:Name="TxtPercent" Text="" FontSize="11" FontWeight="Bold"
                           Foreground="#FAB387" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
