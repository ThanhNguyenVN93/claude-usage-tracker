<Window x:Class="ClaudeUsageTracker.Views.ToastNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Toast" Height="110" Width="330"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" Loaded="Window_Loaded">
    
    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.3"/>
        </Storyboard>
        <Storyboard x:Key="FadeOut" Completed="FadeOut_Completed">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>

    <Border Background="#1E1E2E" CornerRadius="12" BorderBrush="#45475A" BorderThickness="1" Margin="6">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="4" Opacity="0.45"/>
        </Border.Effect>
        <Grid Margin="12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Grid.Row="0">
                <TextBlock Text="⚡" FontSize="13" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="Claude Desktop vừa khởi động" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Main Usage Text -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,4,0,4">
                <TextBlock x:Name="TxtUsage" Text="Quota: 45% đã dùng | 25/45 tin nhắn" FontSize="11" Foreground="#CDD6F4"/>
                <TextBlock x:Name="TxtReset" Text="Reset sau: 2h 45m" FontSize="10" Foreground="#A6ADC8" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Bottom status -->
            <TextBlock Grid.Row="2" Text="⏱ Pop-up chi tiết sẽ mở sau 5s..." FontSize="9" FontStyle="Italic" Foreground="#6C7086"/>
        </Grid>
    </Border>
</Window>
