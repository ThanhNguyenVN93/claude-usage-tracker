<Window x:Class="ClaudeUsageTracker.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" Opacity="0">

    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.25"/>
        </Storyboard>
    </Window.Resources>

    <Border Background="#1E1E2E" CornerRadius="10" BorderBrush="#45475A" BorderThickness="1" Margin="6">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
            </Grid.RowDefinitions>

            <!-- Title row -->
            <Grid Grid.Row="0" Margin="12,10,8,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtIcon" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTitle" FontWeight="Bold" FontSize="12" Foreground="#FAB387"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="210"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Foreground="#6C7086"
                        FontSize="11" Width="20" Height="20" Cursor="Hand" Click="BtnClose_Click"/>
            </Grid>

            <!-- Body -->
            <TextBlock x:Name="TxtBody" Grid.Row="1" Margin="12,0,12,10" FontSize="11"
                       Foreground="#CDD6F4" TextWrapping="Wrap"/>

            <!-- Nút hành động nhanh (tuỳ chọn, chỉ hiện khi ShowToast truyền quickActions) -->
            <StackPanel x:Name="PanelQuickActions" Grid.Row="2" Orientation="Horizontal"
                        Margin="12,0,12,10" Visibility="Collapsed"/>

            <!-- Progress countdown bar -->
            <Border Grid.Row="3" Background="#313244" CornerRadius="0,0,10,10" ClipToBounds="True">
                <Border x:Name="PbFill" Background="#FAB387" CornerRadius="0,0,10,10" HorizontalAlignment="Left"/>
            </Border>
        </Grid>
    </Border>
</Window>
