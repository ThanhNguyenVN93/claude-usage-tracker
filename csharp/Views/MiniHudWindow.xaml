<Window x:Class="ClaudeUsageTracker.Views.MiniHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Usage HUD" SizeToContent="Height" Width="340"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False">

    <Border Background="#181825" CornerRadius="12" BorderBrush="#45475A" BorderThickness="1" Margin="6">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="6" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- Title bar / Draggable -->
            <Border Grid.Row="0" Background="#1E1E2E" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🤖" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtHudTitle" Text="CLAUDE USAGE HUD" FontSize="11" FontWeight="Bold" Foreground="#FAB387" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Foreground="#A6ADC8"
                            FontSize="12" FontWeight="Bold" Width="24" Height="24" Cursor="Hand" Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <StackPanel Grid.Row="1" Margin="14,10">
                <!-- Account and Tier -->
                <TextBlock x:Name="TxtAccount" Text="Claude Pro / Desktop" FontSize="13" FontWeight="Bold" Foreground="#F5E0DC"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <TextBlock x:Name="TxtModel" Text="" FontSize="10" Foreground="#89B4FA" Margin="0,1,0,0"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtRefreshStatus" Text="" FontSize="10" Foreground="#A6ADC8" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="Collapsed"/>

                <!-- Progress Header -->
                <Grid Margin="0,10,0,4">
                    <TextBlock Text="Hạn ngạch chu kỳ:" FontSize="11" Foreground="#A6ADC8" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TxtPercent" Text="45%" FontSize="12" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Custom Progress Bar -->
                <Border Height="8" Background="#313244" CornerRadius="4">
                    <Grid>
                        <ProgressBar x:Name="PbUsage" Value="45" Maximum="100" Height="8" 
                                     Foreground="#10B981" Background="Transparent" BorderThickness="0"/>
                    </Grid>
                </Border>

                <!-- Metrics Rows -->
                <StackPanel Margin="0,10,0,0">
                    <TextBlock x:Name="TxtMessages" Text="• Đã dùng: 25 / 45 tin nhắn" FontSize="11" Foreground="#CDD6F4" Margin="0,1" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtCountdown" Text="• Đếm ngược reset: sau 2h 45m" FontSize="11" Foreground="#CDD6F4" Margin="0,1" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtWeekly" Text="" FontSize="11" Foreground="#CDD6F4" Margin="0,1" Visibility="Collapsed" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtBurnRate" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" Margin="0,1" Visibility="Collapsed" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtExtraUsage" Text="• Dùng thêm (overage): 0%" FontSize="11" Foreground="#FAB387" Margin="0,1" Visibility="Collapsed" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtInsight" Text="" FontSize="11" Foreground="#A6ADC8" Margin="0,3,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtNote" Text="ℹ Chế độ mô phỏng." FontSize="10" FontStyle="Italic" Foreground="#89B4FA" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Quick Slash Command Bar (CLI) -->
                <Border Background="#232336" CornerRadius="6" Padding="8,5" Margin="0,8,0,0">
                    <Grid>
                        <TextBlock Text="⚡ Lệnh nhanh CLI:" FontSize="10" Foreground="#A6ADC8" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnQuickHaiku" Content="⚡ Haiku" Click="BtnQuickHaiku_Click"
                                    ToolTip="Tự động gõ /model haiku vào Terminal/VS Code (Ctrl+Shift+H)"
                                    Background="#313244" Foreground="#89B4FA" BorderThickness="0"
                                    Padding="7,3" FontSize="10" Cursor="Hand" Margin="0,0,4,0">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                </Button.Resources>
                            </Button>
                            <Button x:Name="BtnQuickCompact" Content="🧹 Compact" Click="BtnQuickCompact_Click"
                                    ToolTip="Tự động gõ /compact vào Terminal/VS Code để dọn context (Ctrl+Shift+C)"
                                    Background="#313244" Foreground="#FAB387" BorderThickness="0"
                                    Padding="7,3" FontSize="10" Cursor="Hand" Margin="0,0,4,0">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                </Button.Resources>
                            </Button>
                            <Button x:Name="BtnQuickClear" Content="🔄 Clear" Click="BtnQuickClear_Click"
                                    ToolTip="Tự động gõ /clear vào Terminal/VS Code để bắt đầu phiên sạch mới"
                                    Background="#313244" Foreground="#A6E3A1" BorderThickness="0"
                                    Padding="7,3" FontSize="10" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Bottom Action Footer -->
            <Border Grid.Row="2" Background="#1E1E2E" CornerRadius="0,0,12,12">
                <Grid Margin="10,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Content="🔄 Làm mới" Click="BtnRefresh_Click"
                                Background="#313244" Foreground="#CDD6F4" BorderThickness="0"
                                Padding="8,4" FontSize="10" Cursor="Hand" Margin="0,0,6,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="📈 Thống kê" Click="BtnStats_Click"
                                Background="#313244" Foreground="#CDD6F4" BorderThickness="0"
                                Padding="8,4" FontSize="10" Cursor="Hand" Margin="0,0,6,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="⚙ Cài đặt" Click="BtnSettings_Click"
                                Background="#313244" Foreground="#CDD6F4" BorderThickness="0"
                                Padding="8,4" FontSize="10" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <Button Content="Thu nhỏ" Click="BtnMinimize_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" Foreground="#A6ADC8" BorderThickness="0"
                            FontSize="10" Cursor="Hand"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
