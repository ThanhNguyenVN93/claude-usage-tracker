<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>0.4.2</Version>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <!-- Satellite assembly của .NET (PresentationCore.resources.dll, System.Windows.Forms.resources.dll...)
         chỉ chứa chuỗi dựng sẵn của framework dịch sang 13 thứ tiếng — 17 MB / 221 file trong 13 thư mục con.
         Tool chỉ có tiếng Việt và tiếng Anh, và chuỗi của tool nằm thẳng trong code chứ không qua .resx. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SelfTest\**" />
    <EmbeddedResource Remove="SelfTest\**" />
    <None Remove="SelfTest\**" />
    <Page Remove="SelfTest\**" />
  </ItemGroup>

</Project>
